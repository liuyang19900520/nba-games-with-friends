
# Required: the same Supabase project may be used locally and in production.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Safe defaults: no model bill, no real payment. New wallets are environment-scoped.
AI_MODE=demo
PAYMENT_MODE=demo

# Optional real inference; enable deliberately. Never use NEXT_PUBLIC_ for secrets.
# AI_MODE=llm
# DEEPSEEK_API_KEY=
# AI_MODEL=deepseek-flash

# Optional Stripe TEST checkout (five credits per checkout, price set on server).
# PAYMENT_MODE=stripe_test
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_CREDITS_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Local forwarding uses the secret printed by Stripe CLI, not the hosted secret.

# Legacy lineup tables are shared. Local submissions require dedicated test users.
# LOCAL_TEST_USER_IDS=uuid-of-test-user

# Disabled by default; no notification setup is required to preview the site.
# NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
# NEXT_PUBLIC_ONESIGNAL_APP_ID=

# Do not set VERCEL_ENV locally. Vercel injects it on hosted deployments.
