  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@tarojs/components": "4.3.1",
    "@tarojs/helper": "4.3.1",
    "@tarojs/plugin-framework-react": "4.3.1",
    "@tarojs/plugin-platform-h5": "4.3.1",
    "@tarojs/plugin-platform-weapp": "4.3.1",
    "@tarojs/react": "4.3.1",
    "@tarojs/runtime": "4.3.1",
    "@tarojs/shared": "4.3.1",
    "@tarojs/taro": "4.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.15",
    "@tarojs/cli": "4.3.1",
    "@tarojs/plugin-generator": "^4.3.1",
    "@tarojs/taro-loader": "4.3.1",
    "@tarojs/webpack5-runner": "4.3.1",
    "@types/react": "^18.3.3",
    "babel-preset-taro": "4.3.1",
    "less": "^4.2.0",
    "postcss": "^8.4.38",
    "react-refresh": "^0.14.2",
    "typescript": "^5.4.5",
    "webpack": "5.91.0"
  },
  "allowScripts": {
    "@swc/core@1.3.96": true,
    "@tarojs/binding@4.3.1": true,
    "@tarojs/cli@4.3.1": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=20"
